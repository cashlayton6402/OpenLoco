cmake_minimum_required(VERSION 3.22)
if (NOT DEFINED TEST_ROOT OR NOT IS_ABSOLUTE "${TEST_ROOT}")
    message(FATAL_ERROR "Pass an absolute, disposable -DTEST_ROOT directory")
endif()
get_filename_component(auditor "${CMAKE_CURRENT_LIST_DIR}/../audit-ios-bundle.cmake" ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${TEST_ROOT}/bundle-audit-${run_id}")
set(triplet fixture-ios)

function(make_fixture name)
    set(base "${root}/${name}")
    file(MAKE_DIRECTORY "${base}/source/data/language" "${base}/objects/Bridge" "${base}/OpenLoco.app/language" "${base}/OpenLoco.app/objects")
    file(WRITE "${base}/source/LICENSE" "Synthetic project licence fixture\n")
    file(WRITE "${base}/source/CONTRIBUTORS.md" "Synthetic contributor fixture\n")
    file(MAKE_DIRECTORY "${base}/source/distribution/ios/licences")
    file(WRITE "${base}/source/distribution/ios/licences/OpenGraphics.txt" "Synthetic graphics notice\n")
    file(WRITE "${base}/source/data/language/en-GB.yml" "language: synthetic\n")
    file(WRITE "${base}/objects/Bridge/OG_TEST.dat" "Synthetic redistributable resource fixture\n")
    configure_file("${base}/source/LICENSE" "${base}/OpenLoco.app/LICENSE" COPYONLY)
    configure_file("${base}/source/CONTRIBUTORS.md" "${base}/OpenLoco.app/CONTRIBUTORS.md" COPYONLY)
    configure_file("${base}/source/data/language/en-GB.yml" "${base}/OpenLoco.app/language/en-GB.yml" COPYONLY)
    configure_file("${base}/objects/Bridge/OG_TEST.dat" "${base}/OpenLoco.app/objects/OG_TEST.dat" COPYONLY)
    foreach(file Info.plist OpenLoco Assets.car)
        file(WRITE "${base}/OpenLoco.app/${file}" "Synthetic ${file}; not an Apple executable or asset catalog\n")
    endforeach()
    foreach(component fmt libpng yaml-cpp sdl3 openal-soft zlib)
        file(MAKE_DIRECTORY "${base}/installed/${triplet}/share/${component}")
        file(WRITE "${base}/installed/${triplet}/share/${component}/copyright" "Synthetic ${component} notice\n")
    endforeach()
endfunction()

function(check name should_pass expected_error)
    set(base "${root}/${name}")
    file(TO_NATIVE_PATH "${base}/installed" native_install_path)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DAPP=${base}/OpenLoco.app" "-DSOURCE_DIR=${base}/source"
        "-DOBJECTS_DIR=${base}/objects" "-DINSTALLED_DIR=${native_install_path}"
        "-DTRIPLET=${triplet}" "-DREPORT_FILE=${base}/report.json"
        -DSTAGE_NOTICES=ON -P "${auditor}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if (should_pass)
        if (NOT status EQUAL 0)
            message(FATAL_ERROR "${name} unexpectedly failed: ${output}${error}")
        endif()
        file(READ "${base}/report.json" report)
        string(JSON passed GET "${report}" passed)
        if (NOT passed)
            message(FATAL_ERROR "${name} did not produce a passing audit report")
        endif()
        if (NOT EXISTS "${base}/OpenLoco.app/Licences/third-party/openal-soft.txt")
            message(FATAL_ERROR "${name} did not put dependency notices inside the app")
        endif()
    elseif (status EQUAL 0 OR NOT error MATCHES "${expected_error}")
        message(FATAL_ERROR "${name} failed to reject the fixture for ${expected_error}: ${output}${error}")
    else()
        file(READ "${base}/report.json" report)
        string(JSON passed GET "${report}" passed)
        if (passed)
            message(FATAL_ERROR "${name} left a stale success report after rejection")
        endif()
    endif()
    message(STATUS "PASS ${name}")
endfunction()

