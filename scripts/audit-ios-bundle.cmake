# OpenLoco's resource audit. This does not replace the Mach-O/SDK checks in
# build-ios-unsigned.sh, and is deliberately usable on a non-Apple test host.
cmake_minimum_required(VERSION 3.22)

foreach(required APP SOURCE_DIR OBJECTS_DIR INSTALLED_DIR TRIPLET REPORT_FILE)
    if (NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing audit argument: ${required}")
    endif()
endforeach()
foreach(path_argument APP SOURCE_DIR OBJECTS_DIR INSTALLED_DIR REPORT_FILE)
    file(TO_CMAKE_PATH "${${path_argument}}" ${path_argument})
endforeach()
get_filename_component(report_directory "${REPORT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${report_directory}")
# A failed incremental audit must not leave an older success report behind.
file(WRITE "${REPORT_FILE}" "{\"passed\":false,\"status\":\"incomplete\"}\n")
foreach(directory "${APP}" "${SOURCE_DIR}/data/language" "${OBJECTS_DIR}" "${INSTALLED_DIR}/${TRIPLET}/share")
    if (NOT IS_DIRECTORY "${directory}" OR IS_SYMLINK "${directory}")
        message(FATAL_ERROR "Audit input directory is missing or linked: ${directory}")
    endif()
endforeach()
if (EXISTS "${APP}/_CodeSignature" OR EXISTS "${APP}/embedded.mobileprovision")
    message(FATAL_ERROR "This resource audit/staging command requires an unsigned app")
endif()
# Reject links before any notice staging could follow a path out of the bundle.
file(GLOB_RECURSE initial_entries LIST_DIRECTORIES true "${APP}/*")
foreach(entry IN LISTS initial_entries)
    if (IS_SYMLINK "${entry}")
        message(FATAL_ERROR "Bundle contains a symbolic link: ${entry}")
    endif()
endforeach()

# Build the inventory from this checkout and the pinned dependency installation,
# rather than accepting arbitrary .dat files just because their extension fits.
set(expected Info.plist OpenLoco Assets.car)
if (EXISTS "${APP}/PkgInfo")
    file(SIZE "${APP}/PkgInfo" package_size)
    file(READ "${APP}/PkgInfo" package_header LIMIT 4)
    if (NOT package_size EQUAL 8 OR NOT package_header STREQUAL "APPL")
        message(FATAL_ERROR "Invalid generated PkgInfo metadata")
    endif()
    list(APPEND expected PkgInfo)
endif()
set(verified_count 0)
macro(approve_resource relative origin)
    if (IS_SYMLINK "${origin}" OR NOT EXISTS "${origin}" OR IS_DIRECTORY "${origin}")
        message(FATAL_ERROR "Invalid resource source: ${origin}")
    endif()
    if ("${relative}" IN_LIST expected)
        message(FATAL_ERROR "Duplicate bundle resource name: ${relative}")
    endif()
    if (IS_SYMLINK "${APP}/${relative}" OR NOT EXISTS "${APP}/${relative}" OR IS_DIRECTORY "${APP}/${relative}")
        message(FATAL_ERROR "Required bundle resource missing or linked: ${relative}")
    endif()
    file(SHA256 "${origin}" original_hash)
    file(SHA256 "${APP}/${relative}" bundled_hash)
    if (NOT original_hash STREQUAL bundled_hash)
        message(FATAL_ERROR "Bundle resource differs from its source: ${relative}")
    endif()
    list(APPEND expected "${relative}")
    math(EXPR verified_count "${verified_count} + 1")
endmacro()

set(notice_names OpenLoco.txt OpenLoco-contributors.md OpenGraphics.txt)
set(notice_sources "${SOURCE_DIR}/LICENSE" "${SOURCE_DIR}/CONTRIBUTORS.md" "${SOURCE_DIR}/distribution/ios/licences/OpenGraphics.txt")
set(share "${INSTALLED_DIR}/${TRIPLET}/share")
foreach(component fmt libpng yaml-cpp sdl3 openal-soft zlib)
    if (NOT EXISTS "${share}/${component}/copyright")
        message(FATAL_ERROR "Required dependency notice missing: ${component}")
    endif()
endforeach()
file(GLOB dependency_notices LIST_DIRECTORIES false "${share}/*/copyright")
foreach(notice IN LISTS dependency_notices)
    get_filename_component(component_dir "${notice}" DIRECTORY)
    get_filename_component(component "${component_dir}" NAME)
    list(APPEND notice_names "third-party/${component}.txt")
    list(APPEND notice_sources "${notice}")
endforeach()
list(LENGTH notice_names notice_count)
math(EXPR last_notice "${notice_count} - 1")
foreach(index RANGE 0 ${last_notice})
    list(GET notice_names ${index} name)
    list(GET notice_sources ${index} origin)
    if (STAGE_NOTICES)
        # Staging is requested only by the explicitly unsigned app target.
        get_filename_component(destination "${APP}/Licences/${name}" DIRECTORY)
        file(MAKE_DIRECTORY "${destination}")
        configure_file("${origin}" "${APP}/Licences/${name}" COPYONLY)
    endif()
    approve_resource("Licences/${name}" "${origin}")
endforeach()
approve_resource("LICENSE" "${SOURCE_DIR}/LICENSE")
approve_resource("CONTRIBUTORS.md" "${SOURCE_DIR}/CONTRIBUTORS.md")

file(GLOB languages LIST_DIRECTORIES false "${SOURCE_DIR}/data/language/*")
file(GLOB_RECURSE objects LIST_DIRECTORIES false "${OBJECTS_DIR}/*")
if (NOT languages OR NOT objects)
    message(FATAL_ERROR "The approved language/object inventory is empty")
endif()
foreach(language IN LISTS languages)
    get_filename_component(name "${language}" NAME)
    approve_resource("language/${name}" "${language}")
endforeach()
foreach(object IN LISTS objects)
    get_filename_component(name "${object}" NAME)
    # The current Xcode resource phase places these objects in one flat folder.
    approve_resource("objects/${name}" "${object}")
endforeach()

foreach(required IN LISTS expected)
    if (NOT EXISTS "${APP}/${required}")
        message(FATAL_ERROR "Required bundle file missing: ${required}")
    endif()
endforeach()
file(GLOB_RECURSE bundle_entries LIST_DIRECTORIES true RELATIVE "${APP}" "${APP}/*")
foreach(entry IN LISTS bundle_entries)
    if (IS_SYMLINK "${APP}/${entry}")
        message(FATAL_ERROR "Bundle contains a symbolic link: ${entry}")
    endif()
    if (IS_DIRECTORY "${APP}/${entry}")
        if (NOT entry MATCHES "^(language|objects|Licences|Licences/third-party)$")
            message(FATAL_ERROR "Unexpected bundle directory: ${entry}")
        endif()
    elseif (NOT entry IN_LIST expected AND NOT entry MATCHES "^AppIcon[0-9]+x[0-9]+(@[123]x)?(~ipad)?\\.png$")
        message(FATAL_ERROR "Unapproved bundle file: ${entry}")
    endif()
endforeach()

file(WRITE "${REPORT_FILE}" "{\"passed\":true,\"verifiedResources\":${verified_count},\"notices\":${notice_count},\"inventory\":\"checkout-and-pinned-dependencies\",\"binaryInspection\":\"separate-build-script\"}\n")
message(STATUS "iOS resource audit passed: ${verified_count} source-matched resources")
